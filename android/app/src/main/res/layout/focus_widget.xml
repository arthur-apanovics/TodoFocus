<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout for the Focus home-screen widget.
     Rows are supplied by FocusWidgetListService (RemoteViewsService +
     RemoteViewsFactory) so the list is unbounded and scrollable.
     The header row keeps its own tap-to-open-app PendingIntent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/focus_widget_background"
    android:padding="14dp">

    <!-- Header: "Focus" heading + a count badge of focused steps.
         The whole header is a tap target that opens the app. -->
    <LinearLayout
        android:id="@+id/focus_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/focus_widget_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/focus_widget_heading"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/focus_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_muted"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Empty state — shown when there is nothing in focus. -->
    <TextView
        android:id="@+id/focus_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:text="@string/focus_widget_empty"
        android:textColor="@color/widget_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Scrollable list of subtask rows.
         Adapter is set in FocusWidgetProvider via setRemoteAdapter.
         divider/dividerHeight are nulled out because the row layout handles
         its own inter-group separators. -->
    <ListView
        android:id="@+id/focus_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:visibility="gone" />

</LinearLayout>
